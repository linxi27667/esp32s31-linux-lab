# ESP32-S31 Function Core Board-1 Ethernet (RGMII/YT8531) support.
CONFIG_NET=y
CONFIG_INET=y
CONFIG_PACKET=y
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y
CONFIG_PHYLIB=y
CONFIG_MOTORCOMM_PHY=y
CONFIG_STMMAC_ETH=y
CONFIG_STMMAC_PLATFORM=y
CONFIG_DWMAC_GENERIC=y

# S31 board support required by the GMAC and YT8531 reset/pins.
CONFIG_PM=y
CONFIG_PM_GENERIC_DOMAINS=y
CONFIG_COMMON_CLK=y
CONFIG_ESP32S31_CLOCK=y
CONFIG_PINCTRL=y
CONFIG_PINCTRL_ESP32S31=y
CONFIG_GPIOLIB=y
CONFIG_ESP32S31_PMU=y

# The MAC DMA is non-coherent; the current OpenSBI SBI cache hooks already
# provide this.  Keep the coherent descriptor pool enabled for S31 SRAM.
CONFIG_RISCV_DMA_NONCOHERENT=y
CONFIG_RISCV_NONSTANDARD_CACHE_OPS=y
CONFIG_ESP32S31_CACHE=y
CONFIG_DMA_DECLARE_COHERENT=y
CONFIG_DMA_GLOBAL_POOL=y
CONFIG_OF_RESERVED_MEM=y
