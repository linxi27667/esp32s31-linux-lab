+};
+
+#define to_esp32s31_clk(_hw) container_of(_hw, struct esp32s31_clk, hw)
+
+static void esp32s31_rmw(void __iomem *base, u32 off, u32 clr, u32 set)
+{
+	u32 val = readl(base + off);
+
+	val &= ~clr;
+	val |= set;
+	writel(val, base + off);
+}
