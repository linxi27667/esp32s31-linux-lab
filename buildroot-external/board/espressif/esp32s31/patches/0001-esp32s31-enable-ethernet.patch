+	struct esp32s31_clk *clk;
+	int ret;
+
+	ret = esp32s31_register_clk(dev, priv, id, name,
+				    ESP32S31_CLK_KIND_GENERIC, rate);
+	if (ret)
+		return ret;
+
+	clk = to_esp32s31_clk(priv->onecell->hws[id]);
+	clk->reg = reg;
